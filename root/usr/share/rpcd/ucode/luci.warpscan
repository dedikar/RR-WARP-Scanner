// WARPScan LuCI backend - rpcd/ucode
// Scans Cloudflare WARP endpoints via kernel AmneziaWG, applies best result.

'use strict';

import { popen, readfile, writefile, stat } from 'fs';

const BIN_DIR = '/usr/libexec/warpscan';
const ACCOUNT = '/etc/warpscan-account.json';
const RESULT = '/tmp/wscan_result.txt';
const RESULT_SAVED = '/etc/warpscan-last-result.txt';
const ALIVE = '/tmp/wscan/alive.txt';
const PID = '/tmp/wscan/pid';
const PROGRESS = '/tmp/wscan/progress';
const RPCLOG = '/tmp/warpscan.rpc.log';

function command(cmd) {
	return trim(popen(cmd)?.read?.('all'));
}

function read_file(p) {
	try { return readfile(p); } catch (e) { return null; }
}

function file_exists(p) {
	return stat(p) != null;
}

function shellquote(s) {
	return `'${replace(s ?? '', "'", "'\\''")}'`;
}

function rpclog(method, extra) {
	try {
		const ts = trim(command('date +%Y-%m-%d_%H:%M:%S'));
		const line = `${ts} ${method} ${extra ?? ''}\n`;
		let cur = read_file(RPCLOG) ?? '';
		if (length(cur) > 32768)
			cur = substr(cur, length(cur) - 32768);
		writefile(RPCLOG, cur + line);
	} catch (e) {}
}

function jq_field(p, key) {
	return trim(command(`jq -r '.${key}' ${shellquote(p)} 2>/dev/null`)) ?? '';
}

function account_status() {
	if (!file_exists(ACCOUNT))
		return { registered: false };
	const id = jq_field(ACCOUNT, 'id');
	const peer = jq_field(ACCOUNT, 'peer_public_key');
	const addr = jq_field(ACCOUNT, 'address');
	const priv = jq_field(ACCOUNT, 'private_key');
	if (!id)
		return { registered: false };
	return { registered: true, id, peer_public_key: peer, address: addr, private_key: priv };
}

function uci_get(sel) {
	return trim(command(`uci get ${sel} 2>/dev/null`)) ?? '';
}

// base parameters to build an AmneziaWG .conf for an imported endpoint.
// pulled from the existing warp interface so Jc/Jmin/Jmax/I1 match it;
// on a clean router (no network.warp) the same defaults warpscout uses,
// so the config survives DPI without any manual setup.
function conf_base() {
	const acct = account_status();
	const addr = uci_get('network.warp.addresses');
	const priv = uci_get('network.warp.private_key');
	const peer = uci_get('network.warp_peer.public_key');
	const I1_DEFAULT = '<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>';
	// the registered account is the source of truth for .conf keys: a peer
	// copied to a client must pair with THIS account, not with whatever the
	// router's own interface happens to use.
	return {
		registered: acct.registered,
		address: acct.address ? acct.address + '/32' : (addr || '172.16.0.2/32'),
		private_key: acct.private_key || priv,
		peer_public_key: acct.peer_public_key || peer,
		jc: uci_get('network.warp.awg_jc') || '6',
		jmin: uci_get('network.warp.awg_jmin') || '10',
		jmax: uci_get('network.warp.awg_jmax') || '50',
		s1: uci_get('network.warp.awg_s1') || '0',
		s2: uci_get('network.warp.awg_s2') || '0',
		s3: uci_get('network.warp.awg_s3') || '0',
		s4: uci_get('network.warp.awg_s4') || '0',
		h1: uci_get('network.warp.awg_h1') || '1',
		h2: uci_get('network.warp.awg_h2') || '2',
		h3: uci_get('network.warp.awg_h3') || '3',
		h4: uci_get('network.warp.awg_h4') || '4',
		i1: uci_get('network.warp.awg_i1') || I1_DEFAULT,
		dns: '1.1.1.1, 1.0.0.1',
		mtu: uci_get('network.warp.mtu') || '1280',
		keepalive: uci_get('network.warp_peer.persistent_keepalive') || '25',
		allowed_ips: uci_get('network.warp_peer.allowed_ips') || '0.0.0.0/0'
	};
}

function scan_running() {
	// determine by progress marker written by wscan.sh; 'done' or missing => idle
	const prog = trim(read_file(PROGRESS) ?? '');
	return prog != '' && prog != 'done';
}

const methods = {

	accountStatus: {
		call: function() {
			rpclog('accountStatus');
			return account_status();
		}
	},

	confBase: {
		call: function() {
			rpclog('confBase');
			return conf_base();
		}
	},

	register: {
		call: function() {
			rpclog('register');
			const out = command(`sh ${BIN_DIR}/wregister.sh 2>&1`);
			return { output: out, account: account_status() };
		}
	},

	scanStart: {
		args: { hosts: 0, timeout: 0, mode: "", jobs: 0 },
		call: function(req) {
			rpclog('scanStart', `hosts=${req.args?.hosts} timeout=${req.args?.timeout} mode=${req.args?.mode} jobs=${req.args?.jobs}`);
			if (scan_running())
				return { error: 'scan already running' };

			const hosts = max(1, min(int(req.args?.hosts ?? 60), 600));
			const timeout = max(1, min(int(req.args?.timeout ?? 4), 10));
			const jobs = max(1, min(int(req.args?.jobs ?? 3), 6));
			// "full" sweeps every octet of each subnet; anything else is the fast mode
			const full = (req.args?.mode == 'full') ? ' -f' : '';

			// on a clean router there is no account yet; register one on the fly
			if (!file_exists(ACCOUNT)) {
				rpclog('scanStart', 'no account, registering');
				const reg = command(`sh ${BIN_DIR}/wregister.sh 2>&1`);
				if (!file_exists(ACCOUNT)) {
					rpclog('scanStart', 'auto-register failed');
					return { error: 'account registration failed', output: reg };
				}
			}

			command(`mv -f ${RESULT} ${RESULT_SAVED}`);
			command(`rm -f ${PID} ${PROGRESS} ${RESULT}`);
			command('mkdir -p /tmp/wscan');
			writefile(PROGRESS, 'starting');
			writefile('/tmp/wscan/percent', '0');

			// launch in background, fully detached from rpcd so it survives the call
			const cmd = `setsid sh -c 'sh ${BIN_DIR}/wscan.sh -n ${hosts} -t ${timeout} -j ${jobs}${full} > /tmp/wscan.log 2>&1' < /dev/null > /dev/null 2>&1 &`;
			popen(cmd)?.read?.('all');
			return { started: true };
		}
	},

scanStatus: {
		call: function() {
			rpclog('scanStatus');
			const hosts = trim(read_file('/tmp/wscan/hosts.txt')) ?? '';
			const scanned_total = length(split(hosts, '\n')) - (length(hosts) ? 0 : 1);
			const alive_count = int(trim(command('cat /tmp/wscan/alive.*.txt 2>/dev/null | wc -l')) ?? 0);
			const prog = trim(read_file(PROGRESS)) ?? 'starting';
			// "phase1:12:40" => scanned 12 of 40; "phase2:N" => N endpoints processed
			let scanned = 0;
			let phaseName = prog;
			let percent = 0;
			if (prog == 'done') {
				percent = 100;
			} else if (prog != 'starting' && prog != '') {
				const parts = split(prog, ':');
				phaseName = parts[0] ?? prog;
				if (phaseName == 'phase1') {
					scanned = length(parts) >= 2 ? int(parts[1] ?? 0) : 0;
					percent = scanned_total > 0 ? min(80, int(scanned * 80 / scanned_total)) : 0;
				} else if (phaseName == 'phase2') {
					scanned = int(trim(command('wc -l < /tmp/wscan/scanned2.cnt 2>/dev/null')) ?? 0);
					const alive_total = alive_count > 0 ? alive_count : 1;
					percent = 80 + min(19, int(scanned * 20 / alive_total));
				}
			}
			// monotonic: never let the bar go backwards while workers race
			const prev = int(trim(read_file('/tmp/wscan/percent')) ?? '0');
			percent = max(percent, prev);
			writefile('/tmp/wscan/percent', `${percent}`);
			return {
				running: scan_running(),
				total: max(scanned_total, 0),
				alive: max(alive_count, 0),
				phase: prog,
				phaseName: phaseName,
				scanned: scanned,
				percent: min(max(percent, 0), 100)
			};
		}
	},

	scanLog: {
		call: function() {
			const log = read_file(RPCLOG);
			const wscan = read_file('/tmp/wscan.log');
			return {
				rpc: log ? rtrim(log, '\n') : '',
				wscan: wscan ? rtrim(wscan, '\n') : ''
			};
		}
	},

	scanResult: {
		call: function() {
			rpclog('scanResult');
			// prefer a fresh result, fall back to the last one saved across reboots
			let res = read_file(RESULT);
			let src = RESULT;
			if (!res) {
				res = read_file(RESULT_SAVED);
				src = RESULT_SAVED;
			}
			if (!res)
				return { results: [], error: 'no results yet' };
			const lines = split(rtrim(res, '\n'), '\n');
			const items = [];
			let updated = null;
			for (let i = 0; i < length(lines); i++) {
				// ep node country rtt tun_rtt tun_loss torn(1=down)
				const m = match(lines[i], /^(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)$/);
				if (m)
					push(items, {
						endpoint: m[1], node: m[2], country: m[3], ping: m[4],
						tun_ping: m[5], tun_loss: m[6], torn: m[7] == '1'
					});
			}
			try {
				const st = stat(src);
				updated = st ? st.mtime : null;
			} catch (e) {}
			return { results: items, updated: updated, saved: src == RESULT_SAVED };
		}
	},

	applyBest: {
		args: { iface: "" },
		call: function(req) {
			rpclog('applyBest', `iface=${req.args?.iface}`);
			const iface = req.args?.iface ?? 'warp';
			const res = read_file(RESULT);
			if (!res)
				return { error: 'no results' };
			const lines = split(rtrim(res, '\n'), '\n');
			let best = null;
			for (let i = 0; i < length(lines); i++) {
				if (length(split(lines[i], ' ')) >= 7 && split(lines[i], ' ')[6] == '1')
					continue; // skip torn-down endpoints
				best = lines[i];
				break;
			}
			if (!best)
				return { error: 'no working endpoints' };
			const m = match(best, /^(\d+\.\d+\.\d+\.\d+):(\d+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)$/);
			if (!m)
				return { error: `cannot parse: ${best}` };
			const endpoint_host = m[1], endpoint_port = m[2], node = m[3], country = m[4];

			// peer section named ${iface}_peer must exist
			command(`uci get network.${iface}_peer >/dev/null 2>&1 || return`);
			const ok = popen('uci get network.' + iface + '_peer >/dev/null 2>&1; echo $?');
			if (!ok || trim(ok.read('all')) != '0')
				return { error: `peer section '${iface}_peer' not found` };

			// apply via uci CLI (camera: set + commit), then reload network
			const apply = command(`uci set network.${iface}_peer.endpoint_host='${endpoint_host}' ; uci set network.${iface}_peer.endpoint_port='${endpoint_port}' ; uci set network.${iface}_peer.persistent_keepalive='25' ; uci set network.${iface}_peer.allowed_ips='0.0.0.0/0' ; uci commit network 2>&1; echo rc=$?`);
			command(`/etc/init.d/network reload >/dev/null 2>&1`);
			return {
				ok: true,
				interface: iface,
				endpoint: `${endpoint_host}:${endpoint_port}`,
				node, country,
				uci: apply
			};
		}
	}
};

return { 'luci.warpscan': methods };
